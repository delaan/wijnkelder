# Kopieer dit bestand naar ".env" en vul je eigen Supabase-gegevens in.
# Deze waarden vind je in je Supabase project via de "Connect" knop (kies Vite).

VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-public-key

# Onderstaande twee zijn alleen nodig als je het beheerpaneel lokaal wilt
# testen (via "netlify dev"). Voor gewoon lokaal ontwikkelen ("npm run dev")
# hoef je ze niet in te vullen. NOOIT met VITE_ ervoor zetten en nooit delen —
# deze sleutel omzeilt alle beveiliging van je database.
# SUPABASE_URL=https://jouw-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-secret-key
